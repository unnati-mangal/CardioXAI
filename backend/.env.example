# Backend environment variables
# Copy this file to backend/.env and fill in your values.
# Never commit backend/.env to version control.

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret — find it at: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Model ─────────────────────────────────────────────────────────────────────
# Absolute or relative path to model/artifacts/
# MODEL_DIR=../model/artifacts

# ── Prediction threshold ──────────────────────────────────────────────────────
# Research threshold selected via out-of-fold F1 optimisation (NOT clinical)
# PREDICTION_THRESHOLD=0.1684
